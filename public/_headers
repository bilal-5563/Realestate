# Caching rules: Netlify and Cloudflare Pages both read this file from the site root.
# Hashed build output: JS, webfonts (see Base.astro) and anything else whose file name changes
# whenever its content does. Cache for a year, never revalidate.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Photographs and share image: stable names, so a month of caching plus background revalidation.
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/og.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/favicon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# HTML: always check for a new version (cheap 304 when nothing changed).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
/
  Cache-Control: public, max-age=0, must-revalidate
/credits/
  Cache-Control: public, max-age=0, must-revalidate
