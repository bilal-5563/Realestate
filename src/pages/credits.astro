---
import Base from '../layouts/Base.astro';
import { CREDITS } from '../data/credits';
import { SITE } from '../site.config';
---

<Base title={`Image credits — ${SITE.name}`} description={`Photography credits for the ${SITE.legalName} website.`}>
  <main id="main" class="min-h-svh bg-haze text-ink on-light">
    <div class="grid-site pt-s5 pb-s6">
      <a href="/" class="col-span-full type-label text-stone hover:text-markup">← Back to {SITE.name}</a>
      <h1 class="col-span-full mt-s5 type-display">Image <span class="type-accent normal-case text-markup">credits</span></h1>
      <p class="col-span-full lg:col-span-7 mt-s4 text-stone">
        Photographs are used under the <a class="underline" href="https://www.pexels.com/license/">Pexels License</a>.
        Our concept sites feature fictional brands; the photographers below are real and we thank them. The hero model is
        our own 3D scene.
      </p>
      <ol class="col-span-full mt-s5 border-t border-line-light">
        {
          CREDITS.map((c) => (
            <li class="grid gap-1 border-b border-line-light py-s3 md:grid-cols-[1fr_1.4fr_1fr] md:gap-s3">
              <span class="type-label text-stone">{c.use}</span>
              <a href={c.url} class="hover:text-markup">{c.title}</a>
              <a href={c.profile} class="text-stone hover:text-markup md:text-right">{c.by}</a>
            </li>
          ))
        }
      </ol>
    </div>
  </main>
</Base>
