---
/** Structural column hairlines — the scaffold grid from ref-03, used as layout truth, not decoration. */
interface Props {
  tone?: 'dark' | 'light';
  class?: string;
}
const { tone = 'dark', class: cls = '' } = Astro.props;
---

<div class:list={['gridlines pointer-events-none absolute inset-0', tone, cls]} aria-hidden="true">
  <div class="grid-site h-full">
    {Array.from({ length: 12 }).map((_, i) => <span class:list={['gl', i >= 4 && 'hidden md:block', i >= 8 && 'md:hidden lg:block']} />)}
  </div>
</div>

<style>
  .gl {
    border-left: 1px solid var(--line);
    height: 100%;
  }
  .gl:last-child {
    border-right: 1px solid var(--line);
  }
  /* close the right edge at each breakpoint */
  .grid-site > .gl:nth-child(4) {
    border-right: 1px solid var(--line);
  }
  @media (width >= 48rem) {
    .grid-site > .gl:nth-child(4) {
      border-right: 0;
    }
    .grid-site > .gl:nth-child(8) {
      border-right: 1px solid var(--line);
    }
  }
  @media (width >= 64rem) {
    .grid-site > .gl:nth-child(8) {
      border-right: 0;
    }
  }
  .dark {
    --line: rgb(247 245 241 / 0.055);
  }
  .light {
    --line: rgb(14 14 12 / 0.07);
  }
</style>
