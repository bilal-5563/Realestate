---
import { SITE, whatsappHref } from '../site.config';
const year = new Date().getFullYear();
const nav = [
  { href: '#work', label: 'Work' },
  { href: '#capabilities', label: 'Capabilities' },
  { href: '#process', label: 'Process' },
  { href: '#why', label: 'Why Plinth' },
  { href: '#contact', label: 'Contact' },
];
---

<footer class="footer relative bg-ink text-bone" aria-labelledby="footer-title">
  <h2 id="footer-title" class="sr-only">{SITE.legalName}</h2>
  <div class="grid-site pt-s6 pb-s4 gap-y-s5">
    <div class="col-span-full md:col-span-4 lg:col-span-4">
      <p class="type-label text-concrete">Studio</p>
      <p class="mt-s2 max-w-[30ch] text-bone/80">
        Websites for construction companies, architecture studios and real estate developers.
      </p>
    </div>
    <div class="col-span-2 md:col-span-2 lg:col-span-2 lg:col-start-7">
      <p class="type-label text-concrete">Navigate</p>
      <ul class="mt-s2 grid gap-1">
        {nav.map((n) => (<li><a class="footer__link" href={n.href}>{n.label}</a></li>))}
      </ul>
    </div>
    <div class="col-span-2 md:col-span-2 lg:col-span-3 lg:col-start-10">
      <p class="type-label text-concrete">Contact</p>
      <ul class="mt-s2 grid gap-1">
        <li><a class="footer__link" href={`mailto:${SITE.email}`}>Email</a></li>
        <li><a class="footer__link" href={whatsappHref} target="_blank" rel="noopener">WhatsApp</a></li>
        <li><a class="footer__link" href="/credits/">Image credits</a></li>
      </ul>
    </div>

    <p class="footer__word col-span-full" aria-hidden="true">
      {SITE.name}<span class="footer__mark">®</span>
    </p>

    <div class="col-span-full flex flex-wrap justify-between gap-s2 border-t border-line-dark pt-s3 type-label text-concrete">
      <span>© {year} {SITE.legalName}</span>
      <span>Concept sites shown are fictional brands</span>
      <a href="#top" class="footer__link">Back to top ↑</a>
    </div>
  </div>
</footer>

<style>
  .footer__link {
    display: inline-block;
    padding-block: 0.3rem;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0% 1px no-repeat;
    transition: background-size 0.5s var(--ease-expo);
  }
  .footer__link:hover,
  .footer__link:focus-visible {
    background-size: 100% 1px;
  }
  .footer__word {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 62%;
    text-transform: uppercase;
    font-size: clamp(6rem, 31vw, 30rem);
    line-height: 0.78;
    letter-spacing: -0.015em;
    margin-top: var(--spacing-s4);
  }
  .footer__mark {
    font-size: 0.14em;
    vertical-align: top;
    color: var(--color-markup-light);
    margin-left: 0.1em;
  }
</style>
