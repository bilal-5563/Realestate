---
import { ArrowUpRight, MessageCircle } from 'lucide-react';
import { SITE, FORM, whatsappHref, telHref, formConfigured } from '../site.config';
---

<section id="contact" class="contact relative bg-markup text-bone" aria-labelledby="contact-title" data-contact>
  <div class="grid-site relative pt-s6 pb-s6 lg:pt-s7 lg:pb-s7">
    <p class="col-span-full md:col-span-4 type-label text-bone/90"><span class="text-bone">(07)</span>&ensp;Contact</p>
    <p class="hidden md:block md:col-span-4 lg:col-start-9 type-label text-right text-bone/90">Free site visit &amp; quote</p>

    <h2 id="contact-title" class="contact__title col-span-full mt-s5" data-split-lines>
      Let's build <span class="type-accent">it.</span>
    </h2>

    <!-- Direct routes -->
    <div class="col-span-full lg:col-span-5 mt-s5 lg:mt-s6 flex flex-col gap-s4">
      <p class="type-lead max-w-[34ch]" data-fade-up>
        Tell us about the plot, the building or the space, and we'll come back with a site visit and a clear, itemised quote.
      </p>
      <div class="flex flex-col items-start gap-s3" data-fade-up>
        <a href={whatsappHref} class="contact__cta" target="_blank" rel="noopener" data-magnetic data-cursor="Chat">
          <MessageCircle size={22} strokeWidth={1.5} aria-hidden="true" />
          <span data-magnetic-inner>Message us on WhatsApp</span>
          <ArrowUpRight size={20} strokeWidth={1.5} aria-hidden="true" />
        </a>
        <a href={`mailto:${SITE.email}`} class="contact__mail" data-cursor="Write">{SITE.email}</a>
      </div>
      <p class="text-bone/90 text-[0.9375rem] max-w-[38ch]" data-fade-up>
        Free site visit and quote, with no obligation. Prefer a call? Ring <a href={telHref} class="underline">{SITE.phone}</a>{' '}
        or leave a number in the form.
      </p>
    </div>

    <!-- Enquiry form -->
    <form
      class="contact__form col-span-full lg:col-span-6 lg:col-start-7 mt-s5 lg:mt-s6"
      action={FORM.endpoint}
      method="POST"
      novalidate
      data-form
      data-configured={formConfigured ? 'true' : 'false'}
      aria-describedby="form-note"
    >
      <input type="hidden" name="access_key" value={FORM.accessKey} />
      <input type="hidden" name="subject" value={FORM.subject} />
      <input type="hidden" name="from_name" value={`${SITE.legalName}: quote form`} />
      <!-- Honeypot: humans never see or fill this -->
      <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <p id="form-note" class="type-label text-bone/90 mb-s3">Fields marked * are required</p>

      <div class="contact__row">
        <div class="field">
          <label for="f-name">Name *</label>
          <input id="f-name" name="name" type="text" autocomplete="name" required aria-describedby="f-name-err" />
          <p id="f-name-err" class="field__err" data-err></p>
        </div>
        <div class="field">
          <label for="f-company">Company</label>
          <input id="f-company" name="company" type="text" autocomplete="organization" />
        </div>
      </div>

      <div class="contact__row">
        <div class="field">
          <label for="f-email">Email *</label>
          <input id="f-email" name="email" type="email" autocomplete="email" required aria-describedby="f-email-err" />
          <p id="f-email-err" class="field__err" data-err></p>
        </div>
        <div class="field">
          <label for="f-phone">Phone</label>
          <input id="f-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" />
        </div>
      </div>

      <div class="contact__row">
        <div class="field">
          <label for="f-sector">Project type</label>
          <select id="f-sector" name="project_type">
            <option>Villa or private home</option>
            <option>Commercial building</option>
            <option>Interior fit-out</option>
            <option>Renovation or remodel</option>
            <option>Something else</option>
          </select>
        </div>
        <div class="field">
          <label for="f-timing">Timing</label>
          <select id="f-timing" name="timing">
            <option>As soon as possible</option>
            <option>Within 3 months</option>
            <option>Later this year</option>
            <option>Still planning</option>
          </select>
        </div>
      </div>

      <div class="field">
        <label for="f-message">About the project and site *</label>
        <textarea id="f-message" name="message" rows="4" required minlength="10" aria-describedby="f-message-err"></textarea>
        <p id="f-message-err" class="field__err" data-err></p>
      </div>

      <div class="mt-s4 flex flex-wrap items-center gap-s3">
        <button type="submit" class="contact__submit" data-magnetic data-cursor="Send">
          <span data-magnetic-inner>Request a quote</span>
          <ArrowUpRight size={18} strokeWidth={1.5} aria-hidden="true" />
        </button>
        <p class="contact__status" role="status" aria-live="polite" data-form-status></p>
      </div>
    </form>
  </div>
</section>

<style>
  .contact__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 62%;
    text-transform: uppercase;
    font-size: clamp(4.5rem, 17vw, 19rem);
    line-height: 0.84;
    letter-spacing: -0.01em;
  }
  .contact__title .type-accent {
    font-size: 1.02em;
  }

  .contact__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    min-height: 4.25rem;
    padding: 0 1.75rem;
    background: var(--color-bone);
    color: var(--color-markup);
    font-family: var(--font-display);
    font-weight: 650;
    font-stretch: 112%;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: clamp(0.875rem, 1.1vw, 1rem);
    transition:
      background-color 0.5s var(--ease-expo),
      color 0.5s var(--ease-expo);
  }
  .contact__cta:hover,
  .contact__cta:focus-visible {
    background: var(--color-ink);
    color: var(--color-bone);
  }
  .contact__mail {
    font-family: var(--font-display);
    font-weight: 600;
    font-stretch: 80%;
    font-size: clamp(1.75rem, 3.2vw, 3rem);
    line-height: 1;
    background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat;
    padding-bottom: 0.25rem;
    transition: background-size 0.6s var(--ease-expo);
    overflow-wrap: anywhere;
  }
  .contact__mail:hover {
    background-size: 0% 1px;
    background-position: 100% 100%;
  }
  .contact :global(:focus-visible) {
    outline-color: var(--color-bone);
  }

  /* Form */
  .contact__row {
    display: grid;
    gap: 0 var(--spacing-gutter);
  }
  @media (width >= 48rem) {
    .contact__row {
      grid-template-columns: 1fr 1fr;
    }
  }
  .field {
    display: flex;
    flex-direction: column;
    padding-top: var(--spacing-s2);
  }
  .field label {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(247 245 241 / 0.85);
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.6rem 0;
    background: transparent;
    border: 0;
    border-bottom: 1px solid rgb(247 245 241 / 0.45);
    color: var(--color-bone);
    font: inherit;
    font-size: 1.0625rem;
    border-radius: 0;
    transition: border-color 0.3s;
  }
  .field select {
    appearance: none;
    background: linear-gradient(45deg, transparent 50%, currentColor 50%) right 6px top 55% / 6px 6px no-repeat,
      linear-gradient(-45deg, transparent 50%, currentColor 50%) right 0 top 55% / 6px 6px no-repeat;
  }
  .field select option {
    color: var(--color-ink);
  }
  .field textarea {
    resize: vertical;
    min-height: 7.5rem;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-bottom-color: var(--color-bone);
    box-shadow: 0 1px 0 0 var(--color-bone);
  }
  .field [aria-invalid='true'] {
    border-bottom-color: #ffd5cc;
    box-shadow: 0 1px 0 0 #ffd5cc;
  }
  .field__err {
    min-height: 1.25rem;
    margin-top: 0.35rem;
    font-size: 0.875rem;
    color: #ffe4dd;
  }
  .field__err:empty {
    min-height: 0;
    margin: 0;
  }
  .contact__submit {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.5rem;
    padding: 0 1.75rem;
    border: 1px solid var(--color-bone);
    color: var(--color-bone);
    font-family: var(--font-display);
    font-weight: 650;
    font-stretch: 125%;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition:
      background-color 0.5s var(--ease-expo),
      color 0.5s var(--ease-expo);
  }
  .contact__submit:hover,
  .contact__submit:focus-visible {
    background: var(--color-bone);
    color: var(--color-markup);
  }
  .contact__submit[aria-busy='true'] {
    opacity: 0.6;
    pointer-events: none;
  }
  .contact__status {
    font-size: 0.9375rem;
    max-width: 40ch;
  }
</style>
