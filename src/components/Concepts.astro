---
/**
 * 03 — Featured concepts. Three FICTIONAL client brands, each art-directed as a live site.
 * Desktop + motion: pinned horizontal track. Everyone else: a vertical stack (also the no-JS layout).
 * Mock-site internals are decorative (aria-hidden, nothing focusable); each concept has a real text summary.
 */
const pic = (name: string, widths: number[], sizes: string) => ({
  avif: widths.map((w) => `/images/${name}-${w}.avif ${w}w`).join(', '),
  webp: widths.map((w) => `/images/${name}-${w}.webp ${w}w`).join(', '),
  src: `/images/${name}-${widths[Math.min(1, widths.length - 1)]}.webp`,
  sizes,
});
const tower = pic('a-tower', [540, 800, 1200], '(min-width: 1024px) 46vw, 92vw');
const weld = pic('a-weld', [600, 900], '(min-width: 1024px) 16vw, 36vw');
const bSlides = [
  { ...pic('b-pool', [640, 1000, 1600], '(min-width: 1024px) 80vw, 100vw'), name: 'Villa Serein', meta: '5 bedrooms · Hillside · Private pool' },
  { ...pic('b-villa', [640, 1000, 1600], '(min-width: 1024px) 80vw, 100vw'), name: 'Casa Lumen', meta: '4 bedrooms · Sea view · Infinity edge' },
  { ...pic('b-living', [640, 1000, 1600], '(min-width: 1024px) 80vw, 100vw'), name: 'The Atrium Residence', meta: 'Double-height living · Ocean frontage' },
];
const cConcrete = pic('c-concrete', [600, 900], '(min-width: 1024px) 30vw, 60vw');
const cWhite = pic('c-white', [480, 700], '(min-width: 1024px) 16vw, 34vw');
const cRail = pic('c-rail', [600, 900], '(min-width: 1024px) 22vw, 44vw');
---

<section id="work" class="concepts relative bg-ink text-bone" aria-labelledby="work-title" data-concepts>
  <div class="grid-site pt-s6 lg:pt-s7">
    <p class="col-span-full md:col-span-4 type-label text-concrete">
      <span class="text-markup-light">(03)</span>&ensp;Featured concepts
    </p>
    <p class="hidden md:block md:col-span-4 lg:col-start-9 type-label text-right text-concrete">
      Fictional brands · Real craft
    </p>
    <h2 id="work-title" class="concepts__title col-span-full lg:col-span-9 mt-s5" data-split-lines>
      Three sites we'd build <span class="type-accent text-markup-light">tomorrow.</span>
    </h2>
    <p class="col-span-full md:col-span-6 lg:col-span-4 lg:col-start-9 mt-s4 lg:mt-s5 self-end text-bone/75" data-fade-up>
      Each concept is a complete art direction — identity, typography, palette and motion — for one of the sectors we
      serve. The brands are invented; the thinking is exactly what your project gets.
    </p>
  </div>

  <div class="concepts__pin" data-concepts-pin>
    <!-- Horizontal progress (desktop track only) -->
    <div class="concepts__progress grid-site" aria-hidden="true">
      <div class="col-span-full flex items-center gap-s3 type-label text-concrete">
        <span class="w-[7.5rem]" data-progress-label>Concept A</span>
        <span class="concepts__rail"><i data-progress-bar></i></span>
        <span>03 concepts</span>
      </div>
    </div>

    <div class="concepts__track" data-concepts-track>
      <!-- ───────────── A · HALDEN STRUCTURAL ───────────── -->
      <article class="concept" data-concept="a" aria-labelledby="concept-a-title">
        <header class="concept__meta">
          <span class="type-label text-markup-light">Concept A</span>
          <h3 id="concept-a-title" class="type-label">Luxury construction — Halden Structural</h3>
          <span class="concept__tag type-label">Fictional brand</span>
        </header>

        <figure class="concept__frame">
          <div class="concept__chrome" aria-hidden="true"><span>halden-structural.com</span><span>Concept</span></div>
          <div class="cframe" aria-hidden="true">
            <div class="ca">
              <div class="ca__copy">
                <div class="ca__nav">
                  <span class="ca__logo">
                    <svg viewBox="0 0 20 20"><path d="M2 3h16M2 17h16M10 3v14" /></svg>HALDEN
                  </span>
                  <span class="ca__links"><span>Projects</span><span>Capability</span><span>Safety</span></span>
                </div>
                <div>
                  <p class="ca__kicker">Design &amp; build · Towers · Since 1998</p>
                  <p class="ca__headline">Built to<br />tolerance<span>.</span></p>
                  <p class="ca__sub">Main contractor for landmark residential and commercial towers. Engineered, sequenced and delivered in-house.</p>
                </div>
                <div class="ca__specs">
                  <span><b>Structure</b>Post-tensioned concrete</span>
                  <span><b>Delivery</b>Design &amp; build</span>
                  <span><b>Package</b>Structure to façade</span>
                </div>
                <div class="ca__ctas"><span class="ca__btn">View projects</span><span class="ca__btn ca__btn--ghost">Tender portal</span></div>
              </div>
              <div class="ca__media">
                <picture>
                  <source type="image/avif" srcset={tower.avif} sizes={tower.sizes} />
                  <img src={tower.src} srcset={tower.webp} sizes={tower.sizes} width="1200" height="1090" loading="lazy" decoding="async" alt="" />
                </picture>
                <!-- Engineering callouts: drawn in the photo's own pixel space -->
                <svg class="ca__callouts" viewBox="0 0 1200 1090" preserveAspectRatio="xMidYMid slice">
                  <g fill="none" stroke="currentColor" stroke-width="2.5">
                    <path data-callout pathLength="1" d="M630 316 C 790 318, 806 470, 640 486 C 470 500, 452 330, 612 318" />
                    <path data-callout pathLength="1" d="M770 360 L880 250 H1080" />
                    <path data-callout pathLength="1" d="M420 655 H1080" />
                    <path data-callout pathLength="1" d="M985 444 V1086 M970 459 L1000 429 M970 1076 L1000 1046" />
                  </g>
                  <g class="ca__labels" fill="currentColor" text-anchor="end">
                    <text data-callout-label x="1080" y="234">L42 · CROWN</text>
                    <text data-callout-label x="1080" y="638">TL-31 · TRANSFER</text>
                    <text data-callout-label x="968" y="780">+148.6 M</text>
                  </g>
                </svg>
                <div class="ca__inset">
                  <picture>
                    <source type="image/avif" srcset={weld.avif} sizes={weld.sizes} />
                    <img src={weld.src} srcset={weld.webp} sizes={weld.sizes} width="900" height="599" loading="lazy" decoding="async" alt="" />
                  </picture>
                  <span>Steel package — level 18</span>
                </div>
              </div>
            </div>
          </div>
          <figcaption class="sr-only">
            Concept homepage for Halden Structural, a fictional luxury construction contractor: a dark steel layout with a wide
            uppercase headline, project specifications, and amber engineering callouts drawn over a tower under construction.
          </figcaption>
        </figure>

        <dl class="concept__notes">
          <div><dt>Idea</dt><dd>Sell certainty. Every claim is backed by a drawing, a number or a photograph from site.</dd></div>
          <div><dt>Signature</dt><dd>Engineering callouts draw themselves over project photography.</dd></div>
          <div><dt>Built for</dt><dd>Tender teams, developers and investors who check before they call.</dd></div>
        </dl>
      </article>

      <!-- ───────────── B · MAISON AUREL ───────────── -->
      <article class="concept" data-concept="b" aria-labelledby="concept-b-title">
        <header class="concept__meta">
          <span class="type-label text-markup-light">Concept B</span>
          <h3 id="concept-b-title" class="type-label">Luxury real estate — Maison Aurel</h3>
          <span class="concept__tag type-label">Fictional brand</span>
        </header>

        <figure class="concept__frame">
          <div class="concept__chrome" aria-hidden="true"><span>maison-aurel.com</span><span>Concept</span></div>
          <div class="cframe" aria-hidden="true">
            <div class="cb" data-crossfade>
              {
                bSlides.map((s, i) => (
                  <picture class:list={['cb__slide', i === 0 && 'is-active']} data-slide>
                    <source type="image/avif" srcset={s.avif} sizes={s.sizes} />
                    <img src={s.src} srcset={s.webp} sizes={s.sizes} width="1600" height="1067" loading="lazy" decoding="async" alt="" />
                  </picture>
                ))
              }
              <div class="cb__shade"></div>
              <div class="cb__nav">
                <span class="cb__links"><span>Residences</span><span>The Collection</span></span>
                <span class="cb__logo">Maison <em>Aurel</em></span>
                <span class="cb__links cb__links--end"><span>Journal</span><span class="cb__pill">Private viewing</span></span>
              </div>
              <div class="cb__foot">
                <p class="cb__headline">Live above<br /><em>the ordinary.</em></p>
                <div class="cb__card">
                  {
                    bSlides.map((s, i) => (
                      <div class:list={['cb__info', i === 0 && 'is-active']} data-slide-info>
                        <span class="cb__no">Residence 0{i + 1}</span>
                        <span class="cb__name">{s.name}</span>
                        <span class="cb__meta">{s.meta}</span>
                      </div>
                    ))
                  }
                  <div class="cb__bars">{bSlides.map(() => <i data-slide-bar><b /></i>)}</div>
                </div>
              </div>
            </div>
          </div>
          <figcaption class="sr-only">
            Concept homepage for Maison Aurel, a fictional luxury real estate brand: full-bleed property photography that
            crossfades between three residences, a centred serif wordmark and an ivory serif headline, "Live above the ordinary."
          </figcaption>
        </figure>

        <dl class="concept__notes">
          <div><dt>Idea</dt><dd>Sell the feeling first, the floor plan second — then make the viewing one tap away.</dd></div>
          <div><dt>Signature</dt><dd>Slow cinematic crossfades between residences, timed like a film edit.</dd></div>
          <div><dt>Built for</dt><dd>Buyers browsing on a phone at night, and the agents who follow up.</dd></div>
        </dl>
      </article>

      <!-- ───────────── C · ATELIER NORD ───────────── -->
      <article class="concept" data-concept="c" aria-labelledby="concept-c-title">
        <header class="concept__meta">
          <span class="type-label text-markup-light">Concept C</span>
          <h3 id="concept-c-title" class="type-label">Architecture studio — Atelier Nord</h3>
          <span class="concept__tag type-label">Fictional brand</span>
        </header>

        <figure class="concept__frame">
          <div class="concept__chrome concept__chrome--light" aria-hidden="true"><span>ateliernord.studio</span><span>Concept</span></div>
          <div class="cframe" aria-hidden="true">
            <div class="cc">
              <div class="cc__nav">
                <span class="cc__logo">atelier nord</span>
                <span class="cc__links"><span>work</span><span>studio</span><span>writing</span><span>contact</span></span>
              </div>
              <p class="cc__headline"><span class="cc__mask"><span data-c-title>Quiet buildings</span></span><span class="cc__mask"><span data-c-title>for loud cities.</span></span></p>
              <div class="cc__grid">
                <div class="cc__item cc__item--a">
                  <div class="cc__img">
                    <picture><source type="image/avif" srcset={cConcrete.avif} sizes={cConcrete.sizes} /><img src={cConcrete.src} srcset={cConcrete.webp} sizes={cConcrete.sizes} width="900" height="1125" loading="lazy" decoding="async" alt="" /></picture>
                  </div>
                  <span class="cc__cap"><span class="cc__mask"><span data-c-title>01 — Haus am Hang, 2025</span></span></span>
                </div>
                <div class="cc__item cc__item--b">
                  <div class="cc__img">
                    <picture><source type="image/avif" srcset={cWhite.avif} sizes={cWhite.sizes} /><img src={cWhite.src} srcset={cWhite.webp} sizes={cWhite.sizes} width="700" height="875" loading="lazy" decoding="async" alt="" /></picture>
                  </div>
                  <span class="cc__cap"><span class="cc__mask"><span data-c-title>02 — White Court</span></span></span>
                </div>
                <div class="cc__item cc__item--c">
                  <div class="cc__img">
                    <picture><source type="image/avif" srcset={cRail.avif} sizes={cRail.sizes} /><img src={cRail.src} srcset={cRail.webp} sizes={cRail.sizes} width="900" height="600" loading="lazy" decoding="async" alt="" /></picture>
                  </div>
                  <span class="cc__cap"><span class="cc__mask"><span data-c-title>03 — Rue des Arts, refurbishment</span></span></span>
                </div>
                <p class="cc__note">An architecture practice working between landscape and city. Twelve people, one table, no renderings until the model is right.</p>
              </div>
            </div>
          </div>
          <figcaption class="sr-only">
            Concept homepage for Atelier Nord, a fictional architecture studio: a stark white editorial layout with a light
            lowercase wordmark, a thin headline, "Quiet buildings for loud cities," and an asymmetric grid of project photographs.
          </figcaption>
        </figure>

        <dl class="concept__notes">
          <div><dt>Idea</dt><dd>Let the work breathe. White space does the selling; type stays out of the way.</dd></div>
          <div><dt>Signature</dt><dd>Project titles rise from hairline masks; images sharpen to colour on hover.</dd></div>
          <div><dt>Built for</dt><dd>Clients and competition juries who judge a practice by its restraint.</dd></div>
        </dl>
      </article>
    </div>
  </div>
</section>

<style>
  .concepts__title {
    font-family: var(--font-display);
    font-weight: 650;
    font-stretch: 72%;
    font-size: clamp(2.375rem, 5.9vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.012em;
  }

  /* ── Default (mobile, tablet, reduced motion, no JS): vertical stack ── */
  .concepts__pin {
    padding-block: var(--spacing-s5) var(--spacing-s6);
  }
  .concepts__progress {
    display: none;
  }
  .concepts__track {
    display: grid;
    gap: var(--spacing-s6);
    padding-inline: var(--spacing-margin);
  }
  .concept {
    display: grid;
    gap: var(--spacing-s3);
  }
  .concept__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.25rem;
  }
  .concept__tag {
    margin-left: auto;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--color-line-dark);
    color: var(--color-concrete);
  }
  .concept__frame {
    border: 1px solid rgb(247 245 241 / 0.14);
    background: var(--color-graphite);
  }
  .concept__chrome {
    display: flex;
    justify-content: space-between;
    padding: 0.55rem 0.85rem;
    font-family: var(--font-display);
    font-stretch: 125%;
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-concrete);
    border-bottom: 1px solid rgb(247 245 241 / 0.1);
  }
  .cframe {
    container-type: inline-size;
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }
  @media (width >= 48rem) {
    .cframe {
      aspect-ratio: 16 / 11;
    }
  }
  .concept__notes {
    display: grid;
    gap: var(--spacing-s2);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  @media (width >= 48rem) {
    .concept__notes {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--spacing-gutter);
    }
  }
  .concept__notes dt {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-markup-light);
    margin-bottom: 0.35rem;
  }
  .concept__notes dd {
    color: rgb(247 245 241 / 0.72);
  }

  /* ── Desktop horizontal track (class added by JS only when motion is allowed) ── */
  :global(.concepts.is-horizontal) .concepts__pin {
    height: 100svh;
    padding: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }
  :global(.concepts.is-horizontal) .concepts__progress {
    display: grid;
    margin-bottom: var(--spacing-s3);
  }
  :global(.concepts.is-horizontal) .concepts__track {
    display: flex;
    gap: 6vw;
    width: max-content;
    padding-inline: var(--spacing-margin) 12vw;
    will-change: transform;
  }
  :global(.concepts.is-horizontal) .concept {
    width: min(78vw, calc((100svh - 15rem) * 16 / 10.4));
    gap: var(--spacing-s2);
  }
  :global(.concepts.is-horizontal) .cframe {
    aspect-ratio: 16 / 9.4;
  }
  .concepts__rail {
    position: relative;
    flex: 1;
    height: 1px;
    background: var(--color-line-dark);
  }
  .concepts__rail i {
    position: absolute;
    inset: 0;
    background: var(--color-markup-light);
    transform-origin: left;
    transform: scaleX(0);
  }

  /* ═════════ A · HALDEN STRUCTURAL — steel, amber, wide caps ═════════ */
  .ca {
    --amber: #f2a33a;
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: 52% 48%;
    background: #121518;
    color: #e8ebee;
    font-family: var(--font-display);
  }
  .ca__copy {
    order: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5cqi;
    padding: 5cqi;
  }
  .ca__nav {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 4cqi 5cqi;
  }
  .ca__logo {
    display: inline-flex;
    align-items: center;
    gap: 1.2cqi;
    font-weight: 800;
    font-stretch: 125%;
    letter-spacing: 0.08em;
    font-size: 3.4cqi;
  }
  .ca__logo svg {
    width: 3.6cqi;
    height: 3.6cqi;
    fill: none;
    stroke: var(--amber);
    stroke-width: 2.6;
  }
  .ca__links {
    display: none;
    gap: 2.4cqi;
    font-stretch: 125%;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 1.05cqi;
    color: #9aa3ab;
  }
  .ca__kicker {
    font-stretch: 125%;
    font-size: 2.2cqi;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--amber);
  }
  .ca__headline {
    margin-top: 1.5cqi;
    font-weight: 800;
    font-stretch: 125%;
    text-transform: uppercase;
    font-size: 9.5cqi;
    line-height: 0.92;
    letter-spacing: -0.01em;
  }
  .ca__headline span {
    color: var(--amber);
  }
  .ca__sub {
    display: none;
    margin-top: 1.6cqi;
    max-width: 34ch;
    font-family: var(--font-sans);
    font-size: 1.15cqi;
    line-height: 1.5;
    color: #9aa3ab;
  }
  .ca__specs {
    display: none;
  }
  .ca__ctas {
    display: flex;
    gap: 2cqi;
  }
  .ca__btn {
    padding: 2.2cqi 3.4cqi;
    background: var(--amber);
    color: #121518;
    font-weight: 700;
    font-stretch: 125%;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 1.9cqi;
  }
  .ca__btn--ghost {
    background: transparent;
    color: #e8ebee;
    box-shadow: inset 0 0 0 1px rgb(232 235 238 / 0.35);
  }
  .ca__media {
    position: relative;
    overflow: hidden;
  }
  .ca__media > picture img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ca__callouts {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--amber);
  }
  .ca__labels text {
    paint-order: stroke;
    stroke: #121518;
    stroke-width: 7px;
    stroke-linejoin: round;
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 700;
    font-size: 30px;
    letter-spacing: 0.1em;
  }
  .ca__inset {
    display: none;
  }

  @container (width >= 700px) {
    .ca {
      grid-template-rows: none;
      grid-template-columns: 44% 56%;
    }
    .ca__copy {
      order: 0;
      padding: 9cqi 3.6cqi 3.2cqi;
      gap: 0;
    }
    .ca__nav {
      padding: 2.6cqi 3.6cqi;
      background: linear-gradient(#121518, rgb(18 21 24 / 0));
    }
    .ca__logo {
      font-size: 1.7cqi;
    }
    .ca__logo svg {
      width: 1.9cqi;
      height: 1.9cqi;
    }
    .ca__links {
      display: flex;
    }
    .ca__kicker {
      font-size: 1.05cqi;
    }
    .ca__headline {
      font-size: 4.5cqi;
    }
    .ca__sub {
      display: block;
    }
    .ca__specs {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.4cqi;
    }
    .ca__specs span {
      padding-top: 1cqi;
      border-top: 1px solid var(--amber);
      font-family: var(--font-sans);
      font-size: 1cqi;
      line-height: 1.35;
      color: #c5cbd1;
    }
    .ca__specs b {
      display: block;
      margin-bottom: 0.4cqi;
      font-family: var(--font-display);
      font-stretch: 125%;
      font-size: 0.8cqi;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #7f8891;
      font-weight: 500;
    }
    .ca__btn {
      padding: 1.25cqi 2cqi;
      font-size: 0.95cqi;
    }
    .ca__inset {
      display: block;
      position: absolute;
      left: 3cqi;
      bottom: 3cqi;
      width: 19cqi;
      background: #121518;
      padding: 0.6cqi;
    }
    .ca__inset img {
      width: 100%;
      height: auto;
    }
    .ca__inset span {
      display: block;
      padding: 0.7cqi 0.2cqi 0.2cqi;
      font-stretch: 125%;
      font-size: 0.8cqi;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--amber);
    }
  }

  /* ═════════ B · MAISON AUREL — espresso, champagne, serif ═════════ */
  .cb {
    --champagne: #dcc7a3;
    --ivory: #f4efe6;
    position: absolute;
    inset: 0;
    background: #17130f;
    color: var(--ivory);
    overflow: hidden;
  }
  .cb__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  .cb__slide.is-active {
    opacity: 1;
  }
  .cb__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cb__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(23 19 15 / 0.62), rgb(23 19 15 / 0) 24%),
      linear-gradient(to top, rgb(23 19 15 / 0.86), rgb(23 19 15 / 0) 50%);
  }
  .cb__nav {
    position: absolute;
    inset: 0 0 auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 4.5cqi 5cqi;
    font-size: 2cqi;
  }
  .cb__logo {
    font-family: var(--font-serif);
