---
/* Building section drawn in four layers. Geometry derived from one grid so every layer lines up. */
const L = 120, R = 520, GROUND = 440, SLAB = 12, STOREY = 80, FLOORS = 4;
const cols = [130, 230, 330, 430, 510];
const levels = Array.from({ length: FLOORS + 1 }, (_, i) => GROUND - SLAB - i * STOREY); // 428, 348, 268, 188, 108
const top = levels[FLOORS];

const foundation = [
  `M16 ${GROUND} H624`,
  `M${L} ${GROUND - SLAB} H${R} V${GROUND} M${L} ${GROUND - SLAB} V${GROUND}`,
  cols.map((x) => `M${x} ${GROUND} V${GROUND + 78} M${x - 14} ${GROUND + 78} H${x + 14}`).join(' '),
  Array.from({ length: 22 }, (_, i) => `M${30 + i * 27} ${GROUND + 10} l14 -10`).join(' '),
];
const frame = [
  cols.map((x) => `M${x} ${GROUND - SLAB} V${top}`).join(' '),
  levels.slice(1).map((y) => `M${L - 6} ${y} H${R + 6} M${L - 6} ${y - 6} H${R + 6}`).join(' '),
];
const envelope = [
  // glazing: sill + head line per storey, mullions every 25 between columns
  levels.slice(0, FLOORS).map((y) => `M${L + 4} ${y - 16} H${R - 4} M${L + 4} ${y - STOREY + 10} H${R - 4}`).join(' '),
  levels
    .slice(0, FLOORS)
    .map((y) =>
      Array.from({ length: Math.floor((R - L) / 25) }, (_, i) => L + 12 + i * 25)
        .filter((x) => !cols.some((c) => Math.abs(c - x) < 6))
        .map((x) => `M${x} ${y - 16} V${y - STOREY + 10}`)
        .join(' '),
    )
    .join(' '),
  `M${L - 8} ${top - 6} V${top - 26} H${R + 8} V${top - 6}`,
];
const handover = [
  // canopy + door
  `M146 ${GROUND - SLAB - 58} H214 M180 ${GROUND - SLAB} V${GROUND - SLAB - 46} H202 V${GROUND - SLAB}`,
  // trees
  `M70 ${GROUND} V${GROUND - 46} M70 ${GROUND - 70} a22 26 0 1 1 0.1 0 M574 ${GROUND} V${GROUND - 38} M574 ${GROUND - 58} a18 20 0 1 1 0.1 0`,
  // people for scale
  `M248 ${GROUND - SLAB - 6} l5 -24 l5 24 M253 ${GROUND - SLAB - 30} v-12 M253 ${GROUND - SLAB - 47} a5 5 0 1 1 0.1 0 M272 ${GROUND - SLAB - 6} l4 -20 l4 20 M276 ${GROUND - SLAB - 26} v-10 M276 ${GROUND - SLAB - 40} a4 4 0 1 1 0.1 0`,
  // overall height dimension
  `M566 ${GROUND - SLAB} V${top - 26} M558 ${GROUND - SLAB + 8} l16 -16 M558 ${top - 18} l16 -16`,
];

const steps = [
  {
    layer: 'Foundation',
    title: 'Discovery & strategy',
    time: 'Week 1',
    body: 'We study your projects, buyers and competitors, then agree the sitemap, content plan and what success looks like.',
    items: ['Workshop', 'Sitemap', 'Content plan'],
  },
  {
    layer: 'Frame',
    title: 'Design',
    time: 'Weeks 1–3',
    body: 'Art direction, typography and every key page designed for phone, tablet and desktop. Your first draft lands within seven days.',
    items: ['Art direction', 'Page designs', 'Prototype'],
  },
  {
    layer: 'Envelope',
    title: 'Build',
    time: 'Weeks 3–6',
    body: 'Hand-built in Astro with motion, a CMS where you need one, and a performance budget enforced on every page.',
    items: ['Development', 'Motion', 'CMS'],
  },
  {
    layer: 'Handover',
    title: 'Launch & care',
    time: 'Week 6 onward',
    body: 'SEO, analytics and training for your team, then a month of quiet tuning once real visitors arrive.',
    items: ['SEO', 'Training', 'Aftercare'],
  },
];
const layers = [foundation, frame, envelope, handover];
---

<section id="process" class="process relative bg-graphite text-bone" aria-labelledby="process-title" data-process>
  <div class="grid-site pt-s6 lg:pt-s7">
    <p class="col-span-full md:col-span-4 type-label text-concrete"><span class="text-markup-pale">(05)</span>&ensp;Process</p>
    <p class="hidden md:block md:col-span-4 lg:col-start-9 type-label text-right text-concrete">Four stages · Six weeks typical</p>
    <h2 id="process-title" class="process__title col-span-full lg:col-span-10 mt-s5" data-split-lines>
      We build websites the way you build <span class="type-accent text-markup-pale">buildings.</span>
    </h2>
  </div>

  <div class="process__body grid-site pb-s6 lg:pb-s7">
    <!-- Sticky drawing -->
    <div class="process__stick" aria-hidden="true">
      <div class="process__sheet">
        <svg class="process__svg" viewBox="0 0 640 540" fill="none" stroke="currentColor" stroke-linecap="round">
          {
            layers.map((paths, li) => (
              <g data-layer={li} class:list={['process__layer', li === 0 && 'process__layer--ground']}>
                {paths.map((d) => (
                  <path d={d} pathLength="1" data-draw-layer />
                ))}
              </g>
            ))
          }
        </svg>
        <div class="process__sheetmeta type-label">
          <span>Section A–A · <span data-stage-name>{steps[0].layer}</span></span>
          <span><span data-stage-n>01</span> / 04</span>
        </div>
      </div>
    </div>

    <!-- Steps -->
    <div class="process__steps">
      <span class="process__rail" aria-hidden="true"><i data-process-rail></i></span>
      <ol>
      {
        steps.map((s, i) => (
          <li class="pstep" data-step={i}>
            <p class="type-label">
              <span class="text-markup-pale">0{i + 1}</span>&ensp;<span class="pstep__layer">{s.layer}</span>
              <span class="pstep__time">&ensp;·&ensp;{s.time}</span>
            </p>
            <h3 class="pstep__title">{s.title}</h3>
            <p class="pstep__body">{s.body}</p>
            <ul class="pstep__items">
              {s.items.map((it) => (
                <li>{it}</li>
              ))}
            </ul>
          </li>
        ))
      }
      </ol>
    </div>
  </div>
</section>

<style>
  .process__title {
    font-family: var(--font-display);
    font-weight: 650;
    font-stretch: 72%;
    font-size: clamp(2.375rem, 5.4vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.012em;
  }
  .process__body {
    margin-top: var(--spacing-s5);
  }

  /* Mobile/tablet: drawing sticks to the top while the steps scroll under it */
  .process__stick {
    grid-column: 1 / -1;
    position: sticky;
    top: 0.75rem;
    z-index: 2;
    background: var(--color-graphite);
    padding-bottom: var(--spacing-s2);
  }
  .process__stick::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 2.5rem;
    background: linear-gradient(var(--color-graphite), rgb(28 28 26 / 0));
    pointer-events: none;
  }
  .process__sheet {
    border: 1px solid var(--color-line-dark);
    padding: var(--spacing-s2);
    color: var(--color-markup-light);
  }
  .process__svg {
    display: block;
    width: 100%;
    height: auto;
    max-height: 30svh;
  }
  .process__svg path {
    stroke-width: 1.6;
    vector-effect: non-scaling-stroke;
  }
  .process__layer--ground path:first-child {
    stroke: var(--color-concrete);
  }
  .process__sheetmeta {
    display: flex;
    justify-content: space-between;
    margin-top: var(--spacing-s2);
    color: var(--color-concrete);
  }

  .process__steps {
    position: relative;
    grid-column: 1 / -1;
    padding-left: var(--spacing-s4);
  }
  .process__rail {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--color-line-dark);
  }
  .process__rail i {
    position: absolute;
    inset: 0;
    background: var(--color-markup-light);
    transform-origin: top;
    transform: scaleY(0);
  }
  .pstep {
    position: relative;
    min-height: 58svh;
    padding-block: var(--spacing-s5);
    color: var(--color-bone);
  }
  .pstep::before {
    content: '';
    position: absolute;
    left: calc(var(--spacing-s4) * -1 - 4px);
    top: calc(var(--spacing-s5) + 0.25rem);
    width: 9px;
    height: 9px;
    border: 1px solid var(--color-markup-pale);
    background: var(--color-graphite);
    transition: background-color 0.4s;
  }
  /* Inactive steps dim to Concrete (4.7:1 on graphite) — never below readable contrast */
  :global(html.motion-ok) .pstep:not(.is-active) :is(.pstep__title, .pstep__body, .pstep__layer) {
    color: var(--color-concrete);
  }
  .pstep__title,
  .pstep__body,
  .pstep__layer {
    transition: color 0.6s var(--ease-expo);
  }
  .pstep.is-active::before,
  :global(html:not(.motion-ok)) .pstep::before {
    background: var(--color-markup-pale);
  }
  .pstep__time {
    color: var(--color-concrete);
  }
  .pstep__title {
    margin-top: var(--spacing-s2);
    font-family: var(--font-display);
    font-weight: 750;
    font-stretch: 68%;
    text-transform: uppercase;
    font-size: clamp(2.5rem, 5.4vw, 5.25rem);
    line-height: 0.88;
  }
  .pstep__body {
    margin-top: var(--spacing-s3);
    max-width: 44ch;
    color: rgb(247 245 241 / 0.82);
  }
  .pstep__items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: var(--spacing-s3);
  }
  .pstep__items li {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--color-line-dark);
    color: var(--color-concrete);
  }

  @media (width >= 48rem) {
    .process__svg {
      max-height: 34svh;
    }
  }

  /* Desktop: drawing pinned on the left, steps scroll on the right */
  @media (width >= 64rem) {
    .process__stick {
      grid-column: 1 / span 6;
      grid-row: 1;
      align-self: start;
      top: 12svh;
      background: none;
      padding: 0;
    }
    .process__stick::after {
      display: none;
    }
    .process__sheet {
      padding: var(--spacing-s3);
    }
    .process__svg {
      max-height: 62svh;
    }
    .process__steps {
      grid-column: 8 / span 5;
      grid-row: 1;
    }
    .pstep {
      min-height: 78svh;
      padding-block: var(--spacing-s6);
    }
    .pstep::before {
      top: calc(var(--spacing-s6) + 0.25rem);
    }
  }
</style>
